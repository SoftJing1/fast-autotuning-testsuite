          p_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                            &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                            &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                            &K2_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                            &K2_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                            &K2_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
          );
          #elif CACHE_L_CB != 0
          l_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                            &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                            &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                            &K2_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                            &K2_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                            &K2_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
          );
          #else
          g_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                            &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                            &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                            &K2_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                            &K2_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                            &K2_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
          );
          #endif
        
        }
        #endif
      
      }
      
      p_cb_offset_r_1 += GET_LOCAL_SIZE_R_1 * K2_P_NUM_CACHED_ITERATIONS_R_1;
      #if K2_P_NUM_STEPS_R_1 > 1
      for (p_step_r_1 = 1; p_step_r_1 < K2_P_NUM_STEPS_R_1; ++p_step_r_1) {
        #if CACHE_P_CB != 0
        #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI > 0
        for (size_t step = 0; step < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI; ++step) {
          const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
          #if CACHE_L_CB != 0
          const size_t BUFFER_MATCH_ID_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
          const size_t BUFFER_MATCH_ID_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          #else
