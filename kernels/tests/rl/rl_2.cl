          const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(1, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
          const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
