                              &K2_P3_L_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
            );
