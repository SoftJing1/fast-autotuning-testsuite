        p_cb_offset_r_1 = K2_L_FU_ID_R_1 * K2_P_NUM_FU_R_1;
        
        if (K2_L_FU_ID_R_1 < K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) {
