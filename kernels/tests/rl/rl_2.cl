// =============== macro definitions per buffer ===============================
// -------------------- buffer MATCH_ID_INT_RES --------------------

// buffer abstraction
#if   OCL_DIM_L_1 == 1
  #define BUFFER_MATCH_ID_INT_RES_INDEX_1(i, j) i
  #define BUFFER_MATCH_ID_INT_RES_G_SIZE_1 K2_G_CB_SIZE_L_1
  #define BUFFER_MATCH_ID_INT_RES_L_SIZE_1 K2_L_CB_SIZE_L_1
  #define BUFFER_MATCH_ID_INT_RES_P_SIZE_1 K2_P_CB_SIZE_L_1

  #define BUFFER_MATCH_ID_INT_RES_INDEX_0(i, j) j
  #define BUFFER_MATCH_ID_INT_RES_G_SIZE_0 NUM_WG_R_1
  #define BUFFER_MATCH_ID_INT_RES_L_SIZE_0 K2_L_CB_SIZE_R_1
  #define BUFFER_MATCH_ID_INT_RES_P_SIZE_0 K2_P_CB_SIZE_R_1
#elif OCL_DIM_R_1 == 1
  #define BUFFER_MATCH_ID_INT_RES_INDEX_1(i, j) j
  #define BUFFER_MATCH_ID_INT_RES_G_SIZE_1 NUM_WG_R_1
  #define BUFFER_MATCH_ID_INT_RES_L_SIZE_1 K2_L_CB_SIZE_R_1
  #define BUFFER_MATCH_ID_INT_RES_P_SIZE_1 K2_P_CB_SIZE_R_1

  #define BUFFER_MATCH_ID_INT_RES_INDEX_0(i, j) i
  #define BUFFER_MATCH_ID_INT_RES_G_SIZE_0 K2_G_CB_SIZE_L_1
  #define BUFFER_MATCH_ID_INT_RES_L_SIZE_0 K2_L_CB_SIZE_L_1
  #define BUFFER_MATCH_ID_INT_RES_P_SIZE_0 K2_P_CB_SIZE_L_1
#endif
#define K2_G_BUFFER_MATCH_ID_INT_RES(i, j) match_id_int_res[(BUFFER_MATCH_ID_INT_RES_INDEX_1(i, j)) * BUFFER_MATCH_ID_INT_RES_G_SIZE_0 + (BUFFER_MATCH_ID_INT_RES_INDEX_0(i, j))]
#define K2_L_BUFFER_MATCH_ID_INT_RES(i, j) cb_l_match_id_int_res[(BUFFER_MATCH_ID_INT_RES_INDEX_1(i, j))][(BUFFER_MATCH_ID_INT_RES_INDEX_0(i, j))]
#define K2_P_BUFFER_MATCH_ID_INT_RES(i, j) cb_p_match_id_int_res[(BUFFER_MATCH_ID_INT_RES_INDEX_1(i, j))][(BUFFER_MATCH_ID_INT_RES_INDEX_0(i, j))]

// partitioning and cache usage
