        const size_t flat_index = K2_L_FLAT_WI_ID + (((K2_L_NUM_PROCESSED_ELEMENTS_L_1 * K2_L_NUM_PROCESSED_ELEMENTS_R_1) / K2_L_NUM_PROCESSED_ELEMENTS_R_1 * K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1) / K2_L_FLAT_NUM_WI) * K2_L_FLAT_NUM_WI;
        const size_t l_index_l_1 = flat_index / (K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1);
        const size_t l_index_r_1 = flat_index % K2_L_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_G_CB_R_1;
        K2_L_MEM_ID_MEASURE_INT_RES(l_index_l_1, l_index_r_1) = K2_G_MEM_ID_MEASURE_INT_RES(K2_L_TO_G_INDEX_L_1(l_index_l_1), K2_L_TO_G_INDEX_R_1(l_index_r_1));
      }
      #endif
      #endif
      
      
      #if CACHE_L_CB != 0
      barrier(CLK_LOCAL_MEM_FENCE);
      #endif
      
      
      p_cb_offset_l_1 = K2_L_FU_ID_L_1 * K2_P_NUM_FU_L_1;
      
      // phase 1: process private cached iterations in dimension L_1 with all FUs
      #if K2_P_NUM_STEPS_L_1 > 0
      for (size_t p_step_l_1 = 0; p_step_l_1 < K2_P_NUM_STEPS_L_1; ++p_step_l_1) {
        p_cb_offset_r_1 = K2_L_FU_ID_R_1 * K2_P_NUM_FU_R_1;
        
        // phase 1: process private cached iterations in dimension R_1 with all FUs
        #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 > 0
        size_t p_step_r_1 = 0;
        #if CACHE_P_CB != 0
        #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI > 0
        for (size_t step = 0; step < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI; ++step) {
          const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
          #if CACHE_L_CB != 0
          const size_t BUFFER_MATCH_ID_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
          const size_t BUFFER_MATCH_ID_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          #else
          const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
          #endif
          K2_P_MEM_MATCH_ID_INT_RES(p_index_l_1, p_index_r_1) = K2_L_MEM_MATCH_ID_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_R_1(p_index_r_1));
        }
        #endif
        #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) % K2_P_FLAT_NUM_WI > 0
        if (K2_P_FLAT_WI_ID < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) % K2_P_FLAT_NUM_WI) {
          const size_t flat_index = K2_P_FLAT_WI_ID + ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
          #if CACHE_L_CB != 0
          const size_t BUFFER_MATCH_ID_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
          const size_t BUFFER_MATCH_ID_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          #else
          const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
          #endif
          K2_P_MEM_MATCH_ID_INT_RES(p_index_l_1, p_index_r_1) = K2_L_MEM_MATCH_ID_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_R_1(p_index_r_1));
        }
        #endif
        #endif
        
        
        #if CACHE_P_CB != 0
        #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI > 0
        for (size_t step = 0; step < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI; ++step) {
          const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
          #if CACHE_L_CB != 0
          const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
          const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          #else
          const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
          #endif
          K2_P_MEM_MATCH_WEIGHT_INT_RES(p_index_l_1, p_index_r_1) = K2_L_MEM_MATCH_WEIGHT_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_R_1(p_index_r_1));
        }
        #endif
        #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) % K2_P_FLAT_NUM_WI > 0
        if (K2_P_FLAT_WI_ID < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) % K2_P_FLAT_NUM_WI) {
          const size_t flat_index = K2_P_FLAT_WI_ID + ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
          #if CACHE_L_CB != 0
          const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
          const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          #else
          const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
          #endif
          K2_P_MEM_MATCH_WEIGHT_INT_RES(p_index_l_1, p_index_r_1) = K2_L_MEM_MATCH_WEIGHT_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_R_1(p_index_r_1));
        }
        #endif
        #endif
        
        
        #if CACHE_P_CB != 0
        #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI > 0
        for (size_t step = 0; step < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI; ++step) {
          const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
          #if CACHE_L_CB != 0
          const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_ID_MEASURE_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
          const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_ID_MEASURE_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          #else
          const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
          #endif
          K2_P_MEM_ID_MEASURE_INT_RES(p_index_l_1, p_index_r_1) = K2_L_MEM_ID_MEASURE_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_R_1(p_index_r_1));
        }
        #endif
        #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) % K2_P_FLAT_NUM_WI > 0
        if (K2_P_FLAT_WI_ID < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) % K2_P_FLAT_NUM_WI) {
          const size_t flat_index = K2_P_FLAT_WI_ID + ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
          #if CACHE_L_CB != 0
          const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_ID_MEASURE_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
          const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_ID_MEASURE_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          #else
          const size_t p_index_l_1 = flat_index / (K2_P_NUM_PROCESSED_ELEMENTS_R_1);
          const size_t p_index_r_1 = flat_index % K2_P_NUM_PROCESSED_ELEMENTS_R_1;
          #endif
          K2_P_MEM_ID_MEASURE_INT_RES(p_index_l_1, p_index_r_1) = K2_L_MEM_ID_MEASURE_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_R_1(p_index_r_1));
        }
        #endif
        #endif
        
        
        #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL
        for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
          size_t p_iteration_r_1 = 0;
          // process one mda element
          MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
          MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
          ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
          
          
          #if (K2_P_NUM_CACHED_ITERATIONS_R_1 > 1)
          for (p_iteration_r_1 = 1; p_iteration_r_1 < K2_P_NUM_CACHED_ITERATIONS_R_1; ++p_iteration_r_1) {
            // process one mda element
            #if CACHE_P_CB != 0
            p_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &K2_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
            );
            #elif CACHE_L_CB != 0
            l_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &K2_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
            );
            #else
            g_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &K2_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
            );
            #endif
          
          }
          #endif
        
        }
        #else
        for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
          for (size_t p_iteration_r_1 = 0; p_iteration_r_1 < K2_P_NUM_CACHED_ITERATIONS_R_1; ++p_iteration_r_1) {
            // process one mda element
            #if CACHE_P_CB != 0
            p_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &K2_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
            );
            #elif CACHE_L_CB != 0
            l_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &K2_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
            );
            #else
            g_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &K2_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
            );
            #endif
          
          }
        }
        #endif
        
        p_cb_offset_r_1 += GET_LOCAL_SIZE_R_1 * K2_P_NUM_CACHED_ITERATIONS_R_1;
        #if K2_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 > 1
        for (p_step_r_1 = 1; p_step_r_1 < K2_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1; ++p_step_r_1) {
          #if CACHE_P_CB != 0
          #if (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI > 0
          for (size_t step = 0; step < (K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_FLAT_NUM_WI; ++step) {
            const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_MATCH_ID_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1));
            const size_t BUFFER_MATCH_ID_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_L_1, K2_P_NUM_PROCESSED_ELEMENTS_R_1);
