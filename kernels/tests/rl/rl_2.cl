}

// =============== kernel 2 ===================================================
__kernel void rl_2(__global long const * const restrict MATCH_ID_STR(int_res),
                   __global double const * const restrict MATCH_WEIGHT_STR(int_res),
                   __global int const * const restrict ID_MEASURE_STR(int_res),
                   __global long * const restrict MATCH_ID_STR(res_g),
                   __global double * const restrict MATCH_WEIGHT_STR(res_g),
                   __global int * const restrict ID_MEASURE_STR(res_g),
                   __global long * const restrict MATCH_ID_STR(result),
                   __global double * const restrict MATCH_WEIGHT_STR(result),
                   __global int * const restrict ID_MEASURE_STR(result)) {
  // map md_hom dimensions to OpenCL dimensions
  const size_t i_wg_l_1 = GET_GROUP_ID_L_1;
  const size_t i_wi_l_1 = GET_LOCAL_ID_L_1;

  const size_t i_wg_r_1 = GET_GROUP_ID_R_1;
  const size_t i_wi_r_1 = GET_LOCAL_ID_R_1;


  size_t l_cb_offset_l_1;
  size_t l_cb_offset_r_1;
  size_t p_cb_offset_l_1;
  size_t p_cb_offset_r_1;


  // declare variables for caching inputs
  #if CACHE_L_CB != 0
  __local long cb_l_match_id_int_res[BUFFER_MATCH_ID_INT_RES_L_SIZE_1][BUFFER_MATCH_ID_INT_RES_L_SIZE_0];
  __local double cb_l_match_weight_int_res[BUFFER_MATCH_WEIGHT_INT_RES_L_SIZE_1][BUFFER_MATCH_WEIGHT_INT_RES_L_SIZE_0];
  __local int cb_l_id_measure_int_res[BUFFER_ID_MEASURE_INT_RES_L_SIZE_1][BUFFER_ID_MEASURE_INT_RES_L_SIZE_0];
  #endif
  #if CACHE_P_CB != 0
  __private long cb_p_match_id_int_res[BUFFER_MATCH_ID_INT_RES_P_SIZE_1][BUFFER_MATCH_ID_INT_RES_P_SIZE_0];
  __private double cb_p_match_weight_int_res[BUFFER_MATCH_WEIGHT_INT_RES_P_SIZE_1][BUFFER_MATCH_WEIGHT_INT_RES_P_SIZE_0];
  __private int cb_p_id_measure_int_res[BUFFER_ID_MEASURE_INT_RES_P_SIZE_1][BUFFER_ID_MEASURE_INT_RES_P_SIZE_0];
  #endif

  // declare variables for result memory
  long tmp_match_id;
  double tmp_match_weight;
  int tmp_id_measure;
  // ------ LOCAL ------
  #ifdef K2_L_LEVEL_HAS_RESULTS
  __local long MATCH_ID_STR(K2_RES_L_BUFFER_DEF);
  __local double MATCH_WEIGHT_STR(K2_RES_L_BUFFER_DEF);
  __local int ID_MEASURE_STR(K2_RES_L_BUFFER_DEF);
  #endif
  // ------ PRIVATE ------
  #ifdef K2_P_LEVEL_HAS_RESULTS
  __private long MATCH_ID_STR(K2_RES_P_BUFFER_DEF);
  __private double MATCH_WEIGHT_STR(K2_RES_P_BUFFER_DEF);
  __private int ID_MEASURE_STR(K2_RES_P_BUFFER_DEF);
  #endif

  // declare variables for reduction memory (if needed)
  #if L_CB_RES_DEST_LEVEL < LOCAL && (K2_L_NUM_FU_R_1 > 1)
  __local long MATCH_ID_STR(K2_L_REDUCTION_MEM_NAME()CONCAT_IN_DESCENDING_OCL_ORDER([K2_L_CB_SIZE_L_1], [K2_L_NUM_FU_R_1]));
  __local double MATCH_WEIGHT_STR(K2_L_REDUCTION_MEM_NAME()CONCAT_IN_DESCENDING_OCL_ORDER([K2_L_CB_SIZE_L_1], [K2_L_NUM_FU_R_1]));
  __local int ID_MEASURE_STR(K2_L_REDUCTION_MEM_NAME()CONCAT_IN_DESCENDING_OCL_ORDER([K2_L_CB_SIZE_L_1], [K2_L_NUM_FU_R_1]));
  #endif

  // reset memory where reduction takes place for WIs that do not
  // calculate intermediate results, so that reduction can always
  // be done with all WIs
  #if K2_L_NUM_FU_R_1 > 1
  #if ((K2_L_NUM_STEPS_R_1 > 0 && K2_P_NUM_STEPS_R_1 == 0 && K2_P_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0) || (K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 > 0 && K2_P_NUM_STEPS_IN_COMPLETE_G_CB_R_1 == 0 && K2_P_NUM_EXTRA_CACHED_ITERATIONS_IN_COMPLETE_G_CB_R_1 == 0) || (K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0))
  #if (K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
