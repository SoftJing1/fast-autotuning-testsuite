          MATCH_ID_STR(K2_RES_L_BUFFER(l_index_l_1, 0, 0));
        #elif L_CB_RES_DEST_LEVEL == GLOBAL
          MATCH_ID_STR(K2_RES_G_BUFFER(K2_P3_L_TO_G_INDEX_L_1(l_index_l_1), i_wg_r_1, 0, 0));
        #endif
        MATCH_WEIGHT_STR(K2_P3_L_1_L_KERNEL_RES(l_index_l_1)) =
        #if L_CB_RES_DEST_LEVEL < LOCAL
          MATCH_WEIGHT_STR(K2_L_REDUCTION_MEM(l_index_l_1, 0));
        #elif L_CB_RES_DEST_LEVEL == LOCAL
          MATCH_WEIGHT_STR(K2_RES_L_BUFFER(l_index_l_1, 0, 0));
        #elif L_CB_RES_DEST_LEVEL == GLOBAL
          MATCH_WEIGHT_STR(K2_RES_G_BUFFER(K2_P3_L_TO_G_INDEX_L_1(l_index_l_1), i_wg_r_1, 0, 0));
        #endif
        ID_MEASURE_STR(K2_P3_L_1_L_KERNEL_RES(l_index_l_1)) =
        #if L_CB_RES_DEST_LEVEL < LOCAL
          ID_MEASURE_STR(K2_L_REDUCTION_MEM(l_index_l_1, 0));
        #elif L_CB_RES_DEST_LEVEL == LOCAL
