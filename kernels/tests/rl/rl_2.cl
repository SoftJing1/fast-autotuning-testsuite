#define K2_FU_P3_L_1_L_CB_RES_DEST(i) K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(i)), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)
