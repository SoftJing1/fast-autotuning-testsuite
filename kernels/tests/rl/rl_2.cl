                                &ID_MEASURE_STR(K2_FU_PP3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_PP3_L_1_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_L_1_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_L_1_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #else
              g_combine_in_p_cb(&MATCH_ID_STR(K2_FU_PP3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &MATCH_WEIGHT_STR(K2_FU_PP3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &ID_MEASURE_STR(K2_FU_PP3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_PP3_L_1_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_L_1_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_L_1_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #endif
            
            }
          }
          #endif
          
        
        }
        
        
        // ---------- reduction --------------------
        // will never be necessary on this level
        // because K2_P_NUM_FU_R == 1 for OpenCL
        // ---------- end of reduction -------------
        
        // move results upwards in memory hierarchy
        #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL || K2_P_NUM_FU_R_1 > 1
        #if 1
        if (true
        #endif
            && (K2_L_FU_ID_R_1 < K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1)
        #if 1
        )
        #endif
        {
          
          {
            size_t p_iteration_l_1 = 0;
            p_combine_in_l_cb(&MATCH_ID_STR(K2_FU_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_ID_STR(K2_FU_PP3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_PP3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_PP3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)))
            );
          }
        }
        #endif
        
        
      
      }
      
      
      #if CACHE_L_CB != 0
      barrier(CLK_LOCAL_MEM_FENCE);
      #endif
      
      
      
      #endif
    }
    #endif
    
    #if K2_L_NUM_FU_R_1 > 1
    #if (K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
    if (true
    #endif
    #if K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0
        && (K2_G_FU_ID_R_1 < (K2_L_NUM_EXTRA_ELEMENTS_R_1 + K2_L_NUM_FU_R_1 - 1) / K2_L_NUM_FU_R_1)
    #endif
    #if (K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
    )
    #endif
    {
      // wait for all FUs to finish computation
      #if   L_CB_RES_DEST_LEVEL == LOCAL && CACHE_L_CB == 0
      barrier(CLK_LOCAL_MEM_FENCE);
      #elif L_CB_RES_DEST_LEVEL == GLOBAL
      barrier(CLK_GLOBAL_MEM_FENCE);
      #endif
      #if L_CB_RES_DEST_LEVEL < LOCAL
      // parent level in phase 3: process extra private elements in dimension L_1 with a subset of all FUs
      p_cb_offset_l_1 = K2_L_FU_ID_L_1 * K2_P_NUM_FU_L_1;
      
      if (K2_L_FU_ID_L_1 < K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) {
        size_t p_step_l_1 = 0;
        {
          size_t p_iteration_l_1 = 0;
          MATCH_ID_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = MATCH_ID_STR(K2_FU_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          MATCH_WEIGHT_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = MATCH_WEIGHT_STR(K2_FU_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          ID_MEASURE_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = ID_MEASURE_STR(K2_FU_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
        }
        
      
      }
      
      // wait for all values to be copied into reduction memory
      barrier(CLK_LOCAL_MEM_FENCE);
      #endif
      #if K2_L_NUM_FU_R_1 > 1
      // reduction in dimension R_1
      {
        #if (K2_L_NUM_FU_R_1 & (K2_L_NUM_FU_R_1 - 1)) != 0
        // pre processing: reduce number of values to largest possible power of 2
        size_t stride = pow(2.0f, floor(log2((float) K2_L_NUM_FU_R_1)));
        if (K2_L_FU_ID_R_1 < stride && K2_L_FU_ID_R_1 + stride < K2_L_NUM_FU_R_1) {
          // parent level in phase 3: process extra private elements in dimension L_1 with a subset of all FUs
          p_cb_offset_l_1 = K2_L_FU_ID_L_1 * K2_P_NUM_FU_L_1;
          
          if (K2_L_FU_ID_L_1 < K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) {
            size_t p_step_l_1 = 0;
            {
              size_t p_iteration_l_1 = 0;
              #if L_CB_RES_DEST_LEVEL < LOCAL
              // reduction in separate memory location
              combine_in_l_mem(&MATCH_ID_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)),
                              &MATCH_WEIGHT_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)),
                              &ID_MEASURE_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)),
                              &MATCH_ID_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride)),
                              &MATCH_WEIGHT_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride)),
                              &ID_MEASURE_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride))
              );
              #elif L_CB_RES_DEST_LEVEL == LOCAL
              combine_in_l_cb(&MATCH_ID_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                              &MATCH_WEIGHT_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                              &ID_MEASURE_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                              &MATCH_ID_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1)),
                              &MATCH_WEIGHT_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1)),
                              &ID_MEASURE_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1))
              );
              #elif L_CB_RES_DEST_LEVEL == GLOBAL
              combine_in_g_cb(&MATCH_ID_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                              &MATCH_WEIGHT_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                              &ID_MEASURE_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                              &MATCH_ID_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1)),
                              &MATCH_WEIGHT_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1)),
                              &ID_MEASURE_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1))
              );
              #endif
            
            }
            
          
          }
      
        }
        stride /= 2;
        #if L_CB_RES_DEST_LEVEL <= LOCAL
        barrier(CLK_LOCAL_MEM_FENCE);
        #elif L_CB_RES_DEST_LEVEL == GLOBAL
        barrier(CLK_GLOBAL_MEM_FENCE);
        #endif
        #else
        size_t stride = K2_L_NUM_FU_R_1 / 2;
        #endif
        // perform reduction
        for (; stride > 0; stride /= 2) {
          if (K2_L_FU_ID_R_1 < stride) {
            // parent level in phase 3: process extra private elements in dimension L_1 with a subset of all FUs
            p_cb_offset_l_1 = K2_L_FU_ID_L_1 * K2_P_NUM_FU_L_1;
            
            if (K2_L_FU_ID_L_1 < K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) {
              size_t p_step_l_1 = 0;
              {
                size_t p_iteration_l_1 = 0;
                #if L_CB_RES_DEST_LEVEL < LOCAL
                // reduction in separate memory location
                combine_in_l_mem(&MATCH_ID_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)),
                                &MATCH_WEIGHT_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)),
                                &ID_MEASURE_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)),
                                &MATCH_ID_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride)),
                                &MATCH_WEIGHT_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride)),
                                &ID_MEASURE_STR(K2_L_REDUCTION_MEM(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride))
                );
                #elif L_CB_RES_DEST_LEVEL == LOCAL
                combine_in_l_cb(&MATCH_ID_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                                &MATCH_WEIGHT_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                                &ID_MEASURE_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                                &MATCH_ID_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1)),
                                &MATCH_WEIGHT_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1)),
                                &ID_MEASURE_STR(K2_RES_L_BUFFER(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1))
                );
                #elif L_CB_RES_DEST_LEVEL == GLOBAL
                combine_in_g_cb(&MATCH_ID_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                                &MATCH_WEIGHT_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                                &ID_MEASURE_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1, K2_P_FU_ID_R_1)),
                                &MATCH_ID_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1)),
                                &MATCH_WEIGHT_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1)),
                                &ID_MEASURE_STR(K2_RES_G_BUFFER(K2_FU_P3_L_TO_G_INDEX_L_1(K2_FU_PP3_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))), K2_G_FU_ID_R_1, K2_L_FU_ID_R_1 + stride, K2_P_FU_ID_R_1))
                );
                #endif
              
              }
              
            
            }
      
          }
          #if L_CB_RES_DEST_LEVEL <= LOCAL
          barrier(CLK_LOCAL_MEM_FENCE);
          #elif L_CB_RES_DEST_LEVEL == GLOBAL
          barrier(CLK_GLOBAL_MEM_FENCE);
          #endif
        }
        #if L_CB_RES_DEST_LEVEL <= LOCAL
        barrier(CLK_LOCAL_MEM_FENCE);
        #elif L_CB_RES_DEST_LEVEL == GLOBAL
        barrier(CLK_GLOBAL_MEM_FENCE);
        #endif
      }
        #endif
    }
    #endif
    
    // move results upwards in memory hierarchy
    #if G_CB_RES_DEST_LEVEL > L_CB_RES_DEST_LEVEL || K2_L_NUM_FU_R_1 > 1
    #if (K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
    if (true
    #endif
    #if K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0
        && (K2_G_FU_ID_R_1 < (K2_L_NUM_EXTRA_ELEMENTS_R_1 + K2_L_NUM_FU_R_1 - 1) / K2_L_NUM_FU_R_1)
    #endif
    #if (K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
    )
    #endif
    {
      
      #if L_CB_RES_DEST_LEVEL < LOCAL && K2_L_NUM_FU_R_1 == 1
      if (K2_L_FU_ID_R_1 == 0) {
        // parent level in phase 3: process extra private elements in dimension L_1 with a subset of all FUs
        p_cb_offset_l_1 = K2_L_FU_ID_L_1 * K2_P_NUM_FU_L_1;
        
        if (K2_L_FU_ID_L_1 < K2_L_NUM_EXTRA_ELEMENTS_L_1 - K2_G_FU_ID_L_1 * K2_L_NUM_FU_L_1) {
          size_t p_step_l_1 = 0;
          {
            size_t p_iteration_l_1 = 0;
            MATCH_ID_STR(K2_FU_PP3_L_1_P_KERNEL_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = MATCH_ID_STR(K2_FU_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
            MATCH_WEIGHT_STR(K2_FU_PP3_L_1_P_KERNEL_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = MATCH_WEIGHT_STR(K2_FU_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
            ID_MEASURE_STR(K2_FU_PP3_L_1_P_KERNEL_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = ID_MEASURE_STR(K2_FU_P3_L_1_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
