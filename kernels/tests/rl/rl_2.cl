          }
          #endif
          #endif
          
          
          #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL
          for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
            size_t p_iteration_r_1 = 0;
            // process one mda element
            MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
            MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
            ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
            
          
          }
          #else
          for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
            {
              size_t p_iteration_r_1 = 0;
              // process one mda element
              #if CACHE_P_CB != 0
              p_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #elif CACHE_L_CB != 0
              l_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #else
              g_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #endif
            
            }
          }
          #endif
          
        
        }
        
        
        // ---------- reduction --------------------
        // will never be necessary on this level
        // because K2_P_NUM_FU_R == 1 for OpenCL
        // ---------- end of reduction -------------
        
        // move results upwards in memory hierarchy
        #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL || K2_P_NUM_FU_R_1 > 1
        #if 1
        if (true
        #endif
            && (K2_L_FU_ID_R_1 < K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1)
        #if 1
        )
        #endif
        {
          
          for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
            p_combine_in_l_cb(&MATCH_ID_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)))
            );
          }
        }
        #endif
        
        
        p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K2_P_NUM_CACHED_ITERATIONS_L_1;
      } // end of "p_step_l_1"-loop
      #endif
      // phase 2: process extra private iterations in dimension L_1 with all FUs
      #if K2_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0
      {  
        const size_t p_step_l_1 = K2_P_NUM_STEPS_L_1;
        // parent level in phase 3: process extra private elements in dimension R_1 with a subset of all FUs
        p_cb_offset_r_1 = K2_L_FU_ID_R_1 * K2_P_NUM_FU_R_1;
        
        if (K2_L_FU_ID_R_1 < K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) {
          size_t p_step_r_1 = 0;
          #if CACHE_P_CB != 0
          #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI > 0
          for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI; ++step) {
            const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_MATCH_ID_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1));
            const size_t BUFFER_MATCH_ID_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_PP3_R_1_P_MEM_MATCH_ID_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_MATCH_ID_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          #endif
          #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI > 0
          if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI) {
            const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_MATCH_ID_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1));
            const size_t BUFFER_MATCH_ID_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_ID_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_PP3_R_1_P_MEM_MATCH_ID_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_MATCH_ID_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          #endif
          #endif
          
          
          #if CACHE_P_CB != 0
          #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI > 0
          for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI; ++step) {
            const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1));
            const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_MATCH_WEIGHT_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          #endif
          #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI > 0
          if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI) {
            const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1));
            const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_MATCH_WEIGHT_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          #endif
          #endif
          
          
          #if CACHE_P_CB != 0
          #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI > 0
          for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI; ++step) {
            const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_ID_MEASURE_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1));
            const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_ID_MEASURE_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_ID_MEASURE_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          #endif
          #if ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI > 0
          if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI) {
            const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_ID_MEASURE_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1));
            const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_ID_MEASURE_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_ID_MEASURE_INT_RES(K2_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          #endif
          #endif
          
          
          #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL
          for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1; ++p_iteration_l_1) {
            size_t p_iteration_r_1 = 0;
            // process one mda element
            MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
            MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
            ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
            
          
          }
          #else
          for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1; ++p_iteration_l_1) {
            {
              size_t p_iteration_r_1 = 0;
              // process one mda element
              #if CACHE_P_CB != 0
              p_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #elif CACHE_L_CB != 0
              l_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #else
              g_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #endif
            
            }
          }
          #endif
          
        
        }
        
        
        // ---------- reduction --------------------
        // will never be necessary on this level
        // because K2_P_NUM_FU_R == 1 for OpenCL
        // ---------- end of reduction -------------
        
        // move results upwards in memory hierarchy
        #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL || K2_P_NUM_FU_R_1 > 1
        #if 1
        if (true
        #endif
            && (K2_L_FU_ID_R_1 < K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1)
        #if 1
        )
        #endif
        {
          
          for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1; ++p_iteration_l_1) {
            p_combine_in_l_cb(&MATCH_ID_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_ID_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)))
            );
          }
        }
        #endif
        
        
        p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1;
      }
      #endif
      // phase 3: process extra private elements in dimension L_1 with a subset of all FUs
      #if K2_P_NUM_EXTRA_ELEMENTS_L_1 > 0
      if (K2_L_FU_ID_L_1 < (K2_P_NUM_EXTRA_ELEMENTS_L_1 + K2_P_NUM_FU_L_1 - 1) / K2_P_NUM_FU_L_1) {  
        // set step variable for access to res buffer
        const size_t p_step_l_1 = K2_P_NUM_STEPS_L_1 + (K2_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0);
        // parent level in phase 3: process extra private elements in dimension R_1 with a subset of all FUs
        p_cb_offset_r_1 = K2_L_FU_ID_R_1 * K2_P_NUM_FU_R_1;
        
        if (K2_L_FU_ID_R_1 < K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1) {
          size_t p_step_r_1 = 0;
          #if CACHE_P_CB != 0
          for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI; ++step) {
            const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_MATCH_ID_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_ID_INT_RES_INDEX_0(1, 1));
            const size_t BUFFER_MATCH_ID_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_ID_INT_RES_INDEX_0(1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_P3_L_1_PP3_R_1_P_MEM_MATCH_ID_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_MATCH_ID_INT_RES(K2_P3_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI) {
            const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_MATCH_ID_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_ID_INT_RES_INDEX_0(1, 1));
            const size_t BUFFER_MATCH_ID_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_ID_INT_RES_INDEX_0(1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_P3_L_1_PP3_R_1_P_MEM_MATCH_ID_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_MATCH_ID_INT_RES(K2_P3_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          #endif
          
          
          #if CACHE_P_CB != 0
          for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI; ++step) {
            const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(1, 1));
            const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_P3_L_1_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_MATCH_WEIGHT_INT_RES(K2_P3_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI) {
            const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(1, 1));
            const size_t BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_MATCH_WEIGHT_INT_RES_INDEX_0(1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_P3_L_1_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_MATCH_WEIGHT_INT_RES(K2_P3_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          #endif
          
          
          #if CACHE_P_CB != 0
          for (size_t step = 0; step < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI; ++step) {
            const size_t flat_index = K2_P_FLAT_WI_ID + step * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_ID_MEASURE_INT_RES_INDEX_0(1, 1));
            const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_ID_MEASURE_INT_RES_INDEX_0(1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_P3_L_1_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_ID_MEASURE_INT_RES(K2_P3_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          if (K2_P_FLAT_WI_ID < ((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) % K2_P_FLAT_NUM_WI) {
            const size_t flat_index = K2_P_FLAT_WI_ID + (((K2_P_NUM_PROCESSED_ELEMENTS_L_1 * K2_P_NUM_PROCESSED_ELEMENTS_R_1) / K2_P_NUM_PROCESSED_ELEMENTS_L_1 * 1 / K2_P_NUM_PROCESSED_ELEMENTS_R_1 * 1) / K2_P_FLAT_NUM_WI) * K2_P_FLAT_NUM_WI;
            #if CACHE_L_CB != 0
            const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_1(p_index_l_1, p_index_r_1) = flat_index / (BUFFER_ID_MEASURE_INT_RES_INDEX_0(1, 1));
            const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_ID_MEASURE_INT_RES_INDEX_0(1, 1);
            #else
            const size_t p_index_l_1 = flat_index / (1);
            const size_t p_index_r_1 = flat_index % 1;
            #endif
            K2_P3_L_1_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_R_1_L_MEM_ID_MEASURE_INT_RES(K2_P3_P_TO_L_INDEX_L_1(p_index_l_1), K2_PP3_P_TO_L_INDEX_R_1(p_index_r_1));
          }
          #endif
          
          
          #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL
          {
            size_t p_iteration_l_1 = 0;
            size_t p_iteration_r_1 = 0;
            // process one mda element
            MATCH_ID_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_P3_L_1_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
            MATCH_WEIGHT_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_P3_L_1_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
            ID_MEASURE_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_P3_L_1_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
            
          
          }
          #else
          {
            size_t p_iteration_l_1 = 0;
            {
              size_t p_iteration_r_1 = 0;
              // process one mda element
              #if CACHE_P_CB != 0
              p_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &MATCH_WEIGHT_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &ID_MEASURE_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_P3_L_1_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_P3_L_1_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_P3_L_1_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #elif CACHE_L_CB != 0
              l_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &MATCH_WEIGHT_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &ID_MEASURE_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_P3_L_1_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_P3_L_1_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_P3_L_1_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #else
              g_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &MATCH_WEIGHT_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &ID_MEASURE_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                                &K2_P3_L_1_PP3_R_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_P3_L_1_PP3_R_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                                &K2_P3_L_1_PP3_R_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
              );
              #endif
            
            }
          }
          #endif
          
        
        }
        
        
        // ---------- reduction --------------------
        // will never be necessary on this level
        // because K2_P_NUM_FU_R == 1 for OpenCL
        // ---------- end of reduction -------------
        
        // move results upwards in memory hierarchy
        #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL || K2_P_NUM_FU_R_1 > 1
        #if 1
        if (true
        #endif
            && (K2_L_FU_ID_R_1 < K2_L_NUM_EXTRA_ELEMENTS_R_1 - K2_G_FU_ID_R_1 * K2_L_NUM_FU_R_1)
        #if 1
        )
        #endif
        {
          
          {
            size_t p_iteration_l_1 = 0;
            p_combine_in_l_cb(&MATCH_ID_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_ID_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)))
            );
          }
        }
        #endif
        
        
      
      }
      #endif
      
      #if CACHE_L_CB != 0
      barrier(CLK_LOCAL_MEM_FENCE);
      #endif
      
      
      
      #endif
    }
    #endif
    
    #if K2_L_NUM_FU_R_1 > 1
    #if (K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
    if (true
    #endif
    #if K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0
        && (K2_G_FU_ID_R_1 < (K2_L_NUM_EXTRA_ELEMENTS_R_1 + K2_L_NUM_FU_R_1 - 1) / K2_L_NUM_FU_R_1)
    #endif
    #if (K2_L_NUM_STEPS_R_1 == 0 && K2_L_NUM_EXTRA_CACHED_ITERATIONS_R_1 == 0 && K2_L_NUM_EXTRA_ELEMENTS_R_1 > 0)
    )
    #endif
    {
      // wait for all FUs to finish computation
      #if   L_CB_RES_DEST_LEVEL == LOCAL && CACHE_L_CB == 0
      barrier(CLK_LOCAL_MEM_FENCE);
      #elif L_CB_RES_DEST_LEVEL == GLOBAL
      barrier(CLK_GLOBAL_MEM_FENCE);
      #endif
      #if L_CB_RES_DEST_LEVEL < LOCAL
      p_cb_offset_l_1 = K2_L_FU_ID_L_1 * K2_P_NUM_FU_L_1;
      
      // phase 1: process private cached iterations in dimension L_1 with all FUs
      #if K2_P_NUM_STEPS_L_1 > 0
      for (size_t p_step_l_1 = 0; p_step_l_1 < K2_P_NUM_STEPS_L_1; ++p_step_l_1) {
        for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
          MATCH_ID_STR(K2_L_REDUCTION_MEM(K2_FU_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = MATCH_ID_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          MATCH_WEIGHT_STR(K2_L_REDUCTION_MEM(K2_FU_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = MATCH_WEIGHT_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          ID_MEASURE_STR(K2_L_REDUCTION_MEM(K2_FU_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = ID_MEASURE_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
        }
        
        p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K2_P_NUM_CACHED_ITERATIONS_L_1;
      } // end of "p_step_l_1"-loop
      #endif
      // phase 2: process extra private iterations in dimension L_1 with all FUs
      #if K2_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0
      {  
        const size_t p_step_l_1 = K2_P_NUM_STEPS_L_1;
        for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1; ++p_iteration_l_1) {
          MATCH_ID_STR(K2_L_REDUCTION_MEM(K2_FU_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = MATCH_ID_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          MATCH_WEIGHT_STR(K2_L_REDUCTION_MEM(K2_FU_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = MATCH_WEIGHT_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          ID_MEASURE_STR(K2_L_REDUCTION_MEM(K2_FU_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = ID_MEASURE_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
        }
        
        p_cb_offset_l_1 += GET_LOCAL_SIZE_L_1 * K2_P_NUM_CACHED_ITERATIONS_IN_COMPLETE_L_CB_L_1;
      }
      #endif
      // phase 3: process extra private elements in dimension L_1 with a subset of all FUs
      #if K2_P_NUM_EXTRA_ELEMENTS_L_1 > 0
      if (K2_L_FU_ID_L_1 < (K2_P_NUM_EXTRA_ELEMENTS_L_1 + K2_P_NUM_FU_L_1 - 1) / K2_P_NUM_FU_L_1) {  
        // set step variable for access to res buffer
        const size_t p_step_l_1 = K2_P_NUM_STEPS_L_1 + (K2_P_NUM_EXTRA_CACHED_ITERATIONS_L_1 > 0);
        {
          size_t p_iteration_l_1 = 0;
          MATCH_ID_STR(K2_L_REDUCTION_MEM(K2_FU_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = MATCH_ID_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          MATCH_WEIGHT_STR(K2_L_REDUCTION_MEM(K2_FU_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = MATCH_WEIGHT_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          ID_MEASURE_STR(K2_L_REDUCTION_MEM(K2_FU_P_TO_L_INDEX_L_1(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)), K2_L_FU_ID_R_1)) = ID_MEASURE_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
        }
        
      
      }
      #endif
      // wait for all values to be copied into reduction memory
      barrier(CLK_LOCAL_MEM_FENCE);
      #endif
      #if K2_L_NUM_FU_R_1 > 1
      // reduction in dimension R_1
      {
        #if (K2_L_NUM_FU_R_1 & (K2_L_NUM_FU_R_1 - 1)) != 0
        // pre processing: reduce number of values to largest possible power of 2
        size_t stride = pow(2.0f, floor(log2((float) K2_L_NUM_FU_R_1)));
        if (K2_L_FU_ID_R_1 < stride && K2_L_FU_ID_R_1 + stride < K2_L_NUM_FU_R_1) {
          p_cb_offset_l_1 = K2_L_FU_ID_L_1 * K2_P_NUM_FU_L_1;
          
          // phase 1: process private cached iterations in dimension L_1 with all FUs
          #if K2_P_NUM_STEPS_L_1 > 0
          for (size_t p_step_l_1 = 0; p_step_l_1 < K2_P_NUM_STEPS_L_1; ++p_step_l_1) {
            for (size_t p_iteration_l_1 = 0; p_iteration_l_1 < K2_P_NUM_CACHED_ITERATIONS_L_1; ++p_iteration_l_1) {
              #if L_CB_RES_DEST_LEVEL < LOCAL
              // reduction in separate memory location
