        K2_PP3_L_1_P_MEM_MATCH_ID_INT_RES(p_index_l_1, p_index_r_1) = K2_P3_L_1_L_MEM_MATCH_ID_INT_RES(K2_PP3_P_TO_L_INDEX_L_1(p_index_l_1), K2_P_TO_L_INDEX_R_1(p_index_r_1));
