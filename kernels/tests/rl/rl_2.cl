inline void combine_in_p_cb(K2_P_CB_RES_POINTER_TYPE long * const match_id_res_a,
              K2_P_CB_RES_POINTER_TYPE double * const match_weight_res_a,
              K2_P_CB_RES_POINTER_TYPE int * const id_measure_res_a,
              K2_P_CB_RES_POINTER_TYPE long const * const match_id_res_b,
              K2_P_CB_RES_POINTER_TYPE double const * const match_weight_res_b,
              K2_P_CB_RES_POINTER_TYPE int const * const id_measure_res_b) {
  if (((*id_measure_res_a) != 14 && (*id_measure_res_b) == 14)
    || (*match_weight_res_b) > (*match_weight_res_a)) {
    *match_id_res_a = *match_id_res_b;
    *match_weight_res_a = *match_weight_res_b;
    *id_measure_res_a = *id_measure_res_b;
  }
}

