            ID_MEASURE_STR(K2_FU_P3_IN_COMPLETE_G_CB_L_1_P_KERNEL_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = ID_MEASURE_STR(K2_FU_L_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1)));
          }
          
        
        }
        #endif
      }
      #else
      #if K2_L_NUM_FU_R_1 == 1
