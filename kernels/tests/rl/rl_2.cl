            const size_t BUFFER_ID_MEASURE_INT_RES_INDEX_0(p_index_l_1, p_index_r_1) = flat_index % BUFFER_ID_MEASURE_INT_RES_INDEX_0(K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_L_1, K2_P_NUM_PROCESSED_ELEMENTS_IN_COMPLETE_L_CB_R_1);
