        #if L_CB_RES_DEST_LEVEL > P_CB_RES_DEST_LEVEL
        {
          size_t p_iteration_l_1 = 0;
          size_t p_iteration_r_1 = 0;
          // process one mda element
          MATCH_ID_STR(K2_FU_P3_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))) = K2_P3_L_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1));
