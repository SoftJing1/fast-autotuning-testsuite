            );
            #elif CACHE_L_CB != 0
            l_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &ID_MEASURE_STR(K2_FU_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &K2_P3_IN_COMPLETE_G_CB_L_1_P_MEM_MATCH_ID_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P3_IN_COMPLETE_G_CB_L_1_P_MEM_MATCH_WEIGHT_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1)),
                              &K2_P3_IN_COMPLETE_G_CB_L_1_P_MEM_ID_MEASURE_INT_RES(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1), K2_P_ITERATION_TO_P_INDEX_R_1(p_iteration_r_1))
            );
            #else
            g_combine_in_p_cb(&MATCH_ID_STR(K2_FU_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
                              &MATCH_WEIGHT_STR(K2_FU_P3_IN_COMPLETE_G_CB_L_1_P_CB_RES_DEST(K2_P_ITERATION_TO_P_INDEX_L_1(p_iteration_l_1))),
